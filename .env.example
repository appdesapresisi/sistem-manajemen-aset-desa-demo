# =============================================================================
# SISTEM MANAJEMEN ASET DESA DEMO — Environment Configuration
# =============================================================================
# Copy file ini ke .env dan isi sesuai konfigurasi server Anda.
# Jangan commit file .env ke git (sudah di-.gitignore).
# =============================================================================

APP_NAME="Sistem Manajemen Aset"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# =============================================================================
# DATABASE
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manajemen_aset
DB_USERNAME=root
DB_PASSWORD=

# =============================================================================
# SESSION & CACHE
# =============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=single
LOG_LEVEL=error

# =============================================================================
# SANCTUM (untuk API External Token)
# =============================================================================
# Domain yang diizinkan akses API via session (pisahkan dengan koma)
SANCTUM_STATEFUL_DOMAINS=your-domain.com

# =============================================================================
# IDENTITAS DESA (digunakan untuk kop surat & header dokumen ekspor PDF/Excel)
# =============================================================================
KODE_LOKASI_DESA=111.3.2.2009
NAMA_LOKASI_DESA=DEMO
DESA_PROVINSI_KODE=11
DESA_PROVINSI_NAMA=PROVINSI DEMO
DESA_KABUPATEN_KODE=111.3
DESA_KABUPATEN_NAMA="KABUPATEN DEMO"
DESA_KECAMATAN_KODE=111.3.2
DESA_KECAMATAN_NAMA="KECAMATAN DEMO"
DESA_NAMA=DEMO
DESA_UPB="PEMERINTAH DESA DEMO"

# =============================================================================
# SUPER DEVELOPER / SAAS PLATFORM OWNER
# =============================================================================
# Hanya akun dengan username atau email ini yang berhak mengakses menu & fitur
# Cadangan Basis Data (Database Backup). Pisahkan dengan koma jika lebih dari satu.
SUPER_DEVELOPER_USERNAMES=developer,owner
SUPER_DEVELOPER_EMAILS=

