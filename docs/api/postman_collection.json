			"name": "1. External API (Bearer Auth)",
			"item": [
				{
					"name": "1. Auth - Generate Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Script Otomatis Simpan Token (Kompatibel Postman & Hoppscotch)",
									"try {",
									"    // 1. Postman environment",
									"    if (typeof pm !== 'undefined' && pm.response && pm.response.code === 200) {",
									"        var jsonPm = pm.response.json();",
									"        if (jsonPm && jsonPm.token) {",
									"            pm.collectionVariables.set('bearer_token', jsonPm.token);",
									"            pm.environment.set('bearer_token', jsonPm.token);",
									"            pm.globals.set('bearer_token', jsonPm.token);",
									"            console.log('[Postman] Token tersimpan ke bearer_token:', jsonPm.token);",
									"        }",
									"    }",
									"    // 2. Hoppscotch environment",
									"    if (typeof pw !== 'undefined' && pw.response) {",
									"        var body = pw.response.body;",
									"        if (typeof body === 'string') {",
									"            try { body = JSON.parse(body); } catch(e) {}",
									"        }",
									"        if (body && body.token) {",
									"            if (pw.env && typeof pw.env.set === 'function') {",
									"                pw.env.set('bearer_token', body.token);",
									"            }",
									"            console.log('[Hoppscotch] Token tersimpan ke bearer_token:', body.token);",
									"        }",
									"    }",
									"} catch (e) {",
									"    console.error('Error auto-setting token:', e);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"Admin123\",\n    \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/external/token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"external",
								"token"
							]
						},
						"description": "Menukarkan username dan password dengan Bearer Token untuk otentikasi client eksternal. Token yang tergenerate otomatis tersimpan ke variabel {{bearer_token}}."
					},
					"response": []
				},
